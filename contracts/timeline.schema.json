{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineHandoff",
  "description": "Output of the Timeline Agent containing word-level and scene-level alignment timestamps.",
  "type": "object",
  "properties": {
    "audio_file": {
      "type": "string",
      "description": "Relative path to master narration audio file"
    },
    "duration_sec": {
      "type": "number",
      "minimum": 0,
      "description": "Total duration of audio in seconds"
    },
    "sample_rate": {
      "type": "integer",
      "description": "Sample rate of audio in Hz"
    },
    "language": {
      "type": "string",
      "description": "Language code or identifier"
    },
    "aligner": {
      "type": "object",
      "description": "Alignment engine and model metadata",
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string" },
        "device": { "type": "string" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Warnings generated during alignment"
    },
    "degraded": {
      "type": "boolean",
      "description": "Whether the run alignment degraded to weighted interpolation or low confidence"
    },
    "low_confidence_scenes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Scene IDs that have low-confidence word alignments"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Scene identifier corresponding to script.json scene id"
          },
          "type": {
            "type": "string",
            "description": "Scene type, e.g. intro, story, outro"
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Start timestamp in seconds"
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "End timestamp in seconds"
          },
          "speech_start": {
            "type": "number",
            "minimum": 0,
            "description": "Timestamp of the first spoken word in the scene"
          },
          "speech_end": {
            "type": "number",
            "minimum": 0,
            "description": "Timestamp of the last spoken word in the scene"
          },
          "sentences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 }
              },
              "required": ["text", "start", "end"]
            }
          },
          "quality": {
            "type": "object",
            "properties": {
              "words": { "type": "integer" },
              "low_confidence_words": { "type": "integer" },
              "min_score": { "type": "number" },
              "unplaced": { "type": "integer" },
              "caption_count": { "type": "integer" },
              "max_late_ms": { "type": "number" },
              "max_cps": { "type": "number" }
            }
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "string",
                  "description": "Original script word token"
                },
                "tts": {
                  "type": "string",
                  "description": "Spoken/respelled TTS form"
                },
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Word start timestamp in seconds"
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Word end timestamp in seconds"
                },
                "score": {
                  "type": "number",
                  "description": "Alignment confidence score"
                },
                "unplaced": {
                  "type": "boolean",
                  "description": "Whether the word was unplaced by the aligner"
                },
                "low_confidence": {
                  "type": "boolean",
                  "description": "Whether the word score fell below confidence threshold"
                }
              },
              "required": ["w", "start", "end", "score"]
            }
          }
        },
        "required": ["id", "start", "end", "speech_start", "speech_end", "sentences", "words"]
      }
    }
  },
  "required": ["audio_file", "duration_sec", "scenes"]
}
