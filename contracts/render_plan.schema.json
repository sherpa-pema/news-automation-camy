{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RenderPlanHandoff",
  "description": "Output of the Motion Agent defining the visual composition and motion graphics plan.",
  "type": "object",
  "properties": {
    "resolution": {
      "type": "string",
      "pattern": "^[0-9]+x[0-9]+$",
      "description": "Target video resolution, e.g. '1920x1080' or '1080x1920'"
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "description": "Frames per second (e.g., 30)"
    },
    "audio_file": {
      "type": "string",
      "description": "Relative path to master audio narration file"
    },
    "duration_sec": {
      "type": "number",
      "minimum": 0,
      "description": "Total duration in seconds"
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "captions_ass": {
      "type": "string",
      "description": "Relative path to generated ASS subtitle file"
    },
    "overlays": {
      "type": "array",
      "description": "Global or scene-specific graphics overlays",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "scene_id": { "type": ["string", "null"] },
          "type": { "type": "string" },
          "png": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "w": { "type": "integer" },
          "h": { "type": "integer" },
          "animation": { "type": ["string", "null"] },
          "fade_in": { "type": "number", "minimum": 0 },
          "fade_out": { "type": "number", "minimum": 0 }
        },
        "required": ["id", "type", "png", "start", "end", "x", "y", "w", "h"],
        "additionalProperties": true
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Scene identifier corresponding to script.json scene id"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "media": {
            "type": "string",
            "description": "Path to primary background media or graphic asset for this scene"
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string" },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 },
                "type": { "type": "string" },
                "motion": { "type": ["string", "null"] }
              },
              "required": ["file", "start", "end", "type"],
              "additionalProperties": true
            }
          },
          "overlays": {
            "type": "array",
            "items": { "type": "object" }
          },
          "lower_third": {
            "type": "object",
            "properties": {
              "headline": { "type": "string" },
              "source_credit": { "type": "string" },
              "style": { "type": "string" }
            },
            "required": ["headline", "source_credit"],
            "additionalProperties": true
          },
          "caption_style": {
            "type": "object",
            "properties": {
              "font": { "type": "string" },
              "font_size": { "type": "integer" },
              "position": { "type": "string", "enum": ["bottom", "middle", "top"] },
              "highlight_color": { "type": "string" }
            },
            "required": ["position"],
            "additionalProperties": true
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "duration_sec": { "type": "number", "minimum": 0 }
            },
            "required": ["type", "duration_sec"],
            "additionalProperties": true
          }
        },
        "required": ["id", "media", "lower_third", "caption_style", "transition"],
        "additionalProperties": true
      }
    }
  },
  "required": ["resolution", "fps", "scenes"],
  "additionalProperties": true
}
