{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScriptHandoff",
  "description": "Output of the Editor Agent containing rewritten broadcast narration scenes.",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": ["English", "Nepali"],
      "description": "Language of the broadcast narration"
    },
    "origin": {
      "type": "string",
      "enum": ["editor", "fixture"],
      "description": "Provenance of the script: editor (generated by Editor Agent) or fixture (mock/test data)"
    },
    "run_kind": {
      "type": "string",
      "description": "Kind of run (e.g. test, production, fixture)"
    },
    "editor_mode": {
      "type": "string",
      "description": "Mode used by Editor Agent (e.g. ide_agent)"
    },
    "draft_sha256": {
      "type": ["string", "null"],
      "description": "SHA-256 hash of the draft script before validation"
    },
    "validator_fingerprint": {
      "type": ["object", "null"],
      "description": "Fingerprint of validator script and config at time of validation",
      "properties": {
        "validator_sha256": { "type": "string" },
        "editor_config_sha256": { "type": "string" },
        "editor_whitelist_sha256": { "type": "string" },
        "sensitive_triggers_sha256": { "type": "string" },
        "pronunciations_sha256": { "type": "string" },
        "imported_modules_sha256": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "schemas_sha256": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "validated_at": {
      "type": ["string", "null"],
      "description": "ISO 8601 timestamp of validation"
    },
    "date": {
      "type": "string",
      "description": "Run date"
    },
    "total_estimated_duration_sec": {
      "type": "number",
      "description": "Estimated duration in seconds for target video length (120-180 sec)"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Warnings generated during validation"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the scene (e.g., intro, scene_01, outro)"
          },
          "type": {
            "type": "string",
            "enum": ["intro", "story", "outro"],
            "description": "Scene type"
          },
          "headline": {
            "type": "string",
            "description": "On-screen display headline for the news item"
          },
          "narration": {
            "type": "string",
            "description": "Rewritten broadcast narration script in our own words"
          },
          "category": {
            "type": ["string", "null"],
            "enum": [
              "national_politics", "society_local", "culture_entertainment",
              "business_economics", "science_technology", "sports",
              "politics", "economy", "weather", "health", "transport",
              "crime", "disaster", "environment", "society",
              "technology", "tourism", "culture", "entertainment",
              "science", "business", "other", null
            ],
            "description": "Editorial category of the story scene"
          },
          "sensitive": {
            "type": "boolean",
            "description": "Flag indicating sensitive content (crime, accidents, death, minors)"
          },
          "source": {
            "type": "string",
            "description": "News outlet credit to display on screen"
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URLs of member articles in cluster"
          },
          "visual_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Keywords describing desired B-roll visuals or motion elements"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sentence_index": {
                  "type": "integer"
                },
                "source_url": {
                  "type": "string"
                }
              },
              "required": ["sentence_index", "source_url"],
              "additionalProperties": false
            },
            "description": "Sentence-level mapping to supporting article URLs"
          },
          "est_duration_sec": {
            "type": ["number", "null"],
            "description": "Estimated duration in seconds for this scene"
          }
        },
        "required": ["id", "type", "headline", "narration", "source", "source_urls", "visual_keywords", "sensitive", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["language", "origin", "scenes"],
  "additionalProperties": false
}
