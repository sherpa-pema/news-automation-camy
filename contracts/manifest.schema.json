{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "description": "Orchestrator manifest tracking the state, timing, inputs, and outputs of all pipeline stages.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique run ID, typically YYYY-MM-DD or YYYY-MM-DD_HHMMSS"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Run date in YYYY-MM-DD format"
    },
    "run_kind": {
      "type": "string",
      "description": "Kind of run (e.g. test, production, fixture)"
    },
    "manual_edits": {
      "type": "array",
      "description": "Log of manual edits made to run files",
      "items": {
        "type": "object",
        "required": ["file", "what", "why", "timestamp"],
        "properties": {
          "file": { "type": "string" },
          "what": { "type": "string" },
          "why": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "paused", "done", "failed", "abandoned"],
      "description": "Overall pipeline execution status"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of run creation"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of last manifest update"
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "running", "prepared", "needs_revision", "awaiting_approval", "done", "failed"]
          },
          "start_time": {
            "type": ["string", "null"]
          },
          "end_time": {
            "type": ["string", "null"]
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0
          },
          "max_retries": {
            "type": "integer",
            "minimum": 0
          },
          "input_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "output_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "error_message": {
            "type": ["string", "null"]
          },
          "metrics": {
            "type": "object",
            "description": "Optional metrics such as article counts per source",
            "additionalProperties": true
          },
          "source_errors": {
            "type": "object",
            "description": "Optional map of source name to error message",
            "additionalProperties": { "type": "string" }
          }
        },
        "required": ["status", "retry_count", "input_files", "output_files"],
        "additionalProperties": false
      }
    }
  },
  "required": ["run_id", "date", "status", "created_at", "updated_at", "stages"],
  "additionalProperties": false
}
